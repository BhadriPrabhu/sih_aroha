{
  "listeners": [
    {
      "address": "0.0.0.0",
      "port": 8080,
      "https": false
    }
  ],
  "db_clients": [
    {
      "name": "default",
      "rdbms": "sqlite3",
      "host": "",
      "port": 0,
      "filename": "/app/data/aroha_facility.db",
      "dbname": "/app/data/aroha_facility.db",
      "user": "",
      "passwd": "",
      "is_fast": true,
      "number_of_connections": 1,
      "timeout": -1.0
    }
  ],
  "plugins": [
    {
      "name": "SqlitePlugin",
      "config": {
        "db_path": "/app/data/aroha_facility.db",
        "migrations_dir": "db/migrations"
      }
    },
    {
      "name": "SyncPlugin",
      "config": {
        "remote_server_url": "http://host.docker.internal:8081",
        "python_backend_url": "http://host.docker.internal:8000",
        "station_id": "stn-maitri",
        "sync_interval_seconds": 5
      }
    }
  ],
  "app": {
    "number_of_threads": 1,
    "enable_cors": true,
    "cors_header": {
      "allow_origin": "*",
      "allow_methods": "GET,POST,PUT,DELETE,OPTIONS",
      "allow_headers": "Content-Type,Authorization"
    },
    "client_max_body_size": "32M",
    "client_max_memory_body_size": "4M"
  }
}
